{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "Anime desktop mascot - One Piece characters",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.desktoppet.app",
    "productName": "Desktop Pet",
    "mac": { "category": "public.app-category.entertainment" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
